%% hl7-bench: one process, spec and message in, verified ObjectScript out.
%% Render to PNG before use. GitHub renders mermaid inline; LinkedIn does not.
flowchart LR
    subgraph IN[" "]
        direction TB
        SPEC["📝 Spec<br/><i>the mapping, as data</i>"]
        MSG["🧬 Synthetic HL7<br/><i>DFT, ADT, ORU</i>"]
    end

    SPEC --> BENCH
    MSG --> BENCH

    subgraph BENCH["⚙️ hl7-bench &nbsp;·&nbsp; one bun process, stdin to stdout"]
        direction TB
        EMIT["emit → ObjectScript<br/>patch · build · DTL"]
        XFORM["transform → HL7 out<br/>+ highlighted diff"]
        CHECK["check → run on real IRIS<br/>byte-compare to golden"]
    end

    STYLE["🎚️ Style knob<br/>defensive · lean/accumulate"] -.->|reads how, not what| EMIT

    BENCH --> OUT["✅ Verified class<br/><i>paste into Studio</i>"]
    CHECK -->|"49/49 identical"| OUT

    classDef in fill:#1e2530,stroke:#6b7c93,color:#e6edf5,stroke-width:2px
    classDef bench fill:#123024,stroke:#3fa06a,color:#d5f0e2,stroke-width:2px
    classDef knob fill:#2a2313,stroke:#c9a227,color:#f2e6b8,stroke-width:2px
    classDef out fill:#0f2a3a,stroke:#3f8fc0,color:#d5ecf5,stroke-width:2px

    class SPEC,MSG in
    class EMIT,XFORM,CHECK bench
    class STYLE knob
    class OUT out

    style IN fill:#0d1117,stroke:#30363d,color:#e6edf5
    style BENCH fill:#0d1117,stroke:#3fa06a,color:#d5f0e2
