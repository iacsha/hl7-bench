# hl7-bench as a PipeHat drop-in provider.
#
# Install: copy this whole folder into the plugin config dir's providers folder,
# which is NOT under a PipeHat\ subfolder -- PipeHat writes straight into
# Notepad++'s plugin config directory:
#     %APPDATA%\Notepad++\plugins\config\providers\
# (portable install: <Notepad++>\plugins\config\providers\)
# so you end up with ...\config\providers\hl7-bench\hl7-bench.provider
#
# Not sure? Plugins > PipeHat > Open Event Log opens PipeHat.log from that exact
# directory -- the providers folder sits beside it.
# Then restart Notepad++. Uninstall: delete the folder.
#
# ${DIR} is this file's own folder, so nothing here contains a username and the
# package works wherever it is unzipped.

# If bun.exe sits beside these files, this line needs no editing at all.
bench.command = ${DIR}\bun.exe ${DIR}\bench.ts
bench.workdir = .
bench.timeout = 15000
bench.desc    = JavaScript transformer (hl7-bench)

# Lets PipeHat's Check for Updates say when this package is behind. It only
# reports and offers to open the page -- it never downloads or installs, because
# a provider names a command PipeHat executes.
#
# Bump `version` when you cut a release. Until a release is published on the
# repo, the check reports "no release found" and everything else still works.
bench.version     = 1.0.0
bench.updatecheck = iacsha/hl7-bench
bench.updateurl   = https://github.com/iacsha/hl7-bench/releases

# If instead bun.exe is on PATH or somewhere central, comment the line above and
# use one of these:
#
# bench.command = bun.exe ${DIR}\bench.ts
# bench.command = C:\Users\you\tools\bun.exe ${DIR}\bench.ts
