# Bun / node
node_modules/
bun.lockb
*.tsbuildinfo

# Local editor / assistant settings
.claude/
.vscode/
.idea/

# Scratch
*.bak
req-*.json

# Real messages. sample.hl7 is synthetic and IS tracked; anything else you drop
# in here almost certainly is not. Keeping PHI out of git is not recoverable
# after the fact.
*.hl7
!sample.hl7
messages/

# Interface work belongs to the employer, not to this public repo. The bench and
# its patterns are general; a specific feed's transform, field spec, port notes
# and golden gate are not. Keep them local and carry them by hand.
transform.local.ts
transform.*.local.ts
mapping.*.ts
PORT-TO-IRIS.md
LOCAL-LAB.md

# Emitted ObjectScript. It is derived from whatever transform.ts holds, so a
# class emitted from a real interface carries that interface's class name, its
# DocTypes and its field notes. Regenerate it with `bun emit.ts` instead.
*.cls

# Logs. Off by default; `HL7_BENCH_LOG=full` writes diagnostic note text, and a
# note can carry a source value (an unmapped lookup code, whatever a `require`
# rule read). The authoring log records spec names and shapes. Neither belongs
# in git.
logs/

# The publish denylist is local by definition. A list of the customer names you
# are keeping out of a public repo publishes them the moment it is committed.
# .publish-denylist.example is the tracked, empty-of-real-names version.
.publish-denylist

# Local environment. HL7_BENCH_TRANSFORM lives here on a machine where the spec
# is outside the folder: bun loads .env from the working directory, so every
# command picks it up with no shell setup and no exported variable to forget.
.env

# The DPAPI-protected password file. Useless to anyone else, and still not
# something to track: it is a credential for one instance on one machine.
*.dpapi
